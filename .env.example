# Server Configuration
PORT=3000
NODE_ENV=development

# ⚠️ SECURITY WARNING ⚠️
# NEVER commit this file with real credentials!
# NEVER share API keys publicly!
# See SECURITY.md for important security information

# API Keys
# DexScreener API - Optional for higher rate limits
DEXSCREENER_API_KEY=your_dexscreener_api_key_here

# Birdeye API - Get your API key from https://docs.birdeye.so/docs/authentication-api-keys
BIRDEYE_API_KEY=your_birdeye_api_key_here

# Moonarch API - Get your API key from their platform (currently optional/placeholder)
MOONARCH_API_KEY=your_moonarch_api_key_here

# Scraping Configuration
FETCH_INTERVAL_MS=60000

# Filtering Configuration
MAX_AGE_HOURS=48
MAX_HOLDERS=1000
MIN_LIQUIDITY_USD=5000

# Output Configuration
OUTPUT_FORMAT=both
OUTPUT_DIR=./output

# GitHub Integration for drip-dex-launches
GITHUB_ENABLED=false
GITHUB_TOKEN=your_github_token_here
GITHUB_REPO=username/drip-dex-launches
