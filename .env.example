# Server Configuration
PORT=3000
NODE_ENV=development

# API Keys (optional, but recommended for higher rate limits)
# DexScreener API - No API key required for basic usage
# Birdeye API - Get your API key from https://docs.birdeye.so/docs/authentication-api-keys
BIRDEYE_API_KEY=your_birdeye_api_key_here

# Moonarch API - Get your API key from their platform
MOONARCH_API_KEY=your_moonarch_api_key_here

# Scraping Configuration
FETCH_INTERVAL_MS=60000
